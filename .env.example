APP_NAME=Agentic Travel Advisory
ENVIRONMENT=development
LOG_LEVEL=INFO

# mock = no paid API required; openai = use OPENAI_API_KEY
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
LLM_TIMEOUT_SECONDS=45

# Open-Meteo + REST Countries are used when enabled.
ENABLE_LIVE_TOOLS=true
HTTP_TIMEOUT_SECONDS=12
MAX_PARALLEL_AGENTS=8
